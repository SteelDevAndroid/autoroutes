{
  "realm": "supervision",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "VIEWER", "description": "Lecture de la supervision" },
      { "name": "ADMIN", "description": "Lecture et administration (alias, rejeu de la quarantaine)" },
      { "name": "ANOMALY_REPORTER", "description": "Déclaration des anomalies des gares par un agent (serveur MCP)" }
    ]
  },
  "clients": [
    {
      "clientId": "supervision",
      "name": "Supervision des gares de péage",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${SUPERVISION_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${PUBLIC_URL}/login/oauth2/code/keycloak"],
      "webOrigins": ["${PUBLIC_URL}"],
      "attributes": { "post.logout.redirect.uris": "${PUBLIC_URL}/*", "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "agent-anomalies",
      "name": "Agent de déclaration des anomalies (serveur MCP)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${MCP_AGENT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@supervision.invalid",
      "emailVerified": true,
      "firstName": "Lecteur",
      "lastName": "Supervision",
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_VIEWER_PASSWORD}", "temporary": false }],
      "realmRoles": ["VIEWER"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@supervision.invalid",
      "emailVerified": true,
      "firstName": "Administrateur",
      "lastName": "Supervision",
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_ADMIN_USER_PASSWORD}", "temporary": false }],
      "realmRoles": ["ADMIN", "VIEWER"]
    },
    {
      "username": "service-account-agent-anomalies",
      "enabled": true,
      "serviceAccountClientId": "agent-anomalies",
      "realmRoles": ["ANOMALY_REPORTER"]
    }
  ]
}
